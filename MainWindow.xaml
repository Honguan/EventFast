<Window x:Class="EventFast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventFast"
        Title="EventFast" Icon="Assets/EventFast.ico" Height="820" Width="1180" MinHeight="560" MinWidth="820"
        FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13" Foreground="#242633"
        UseLayoutRounding="True" Background="#F5F6FA"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5D8E2" />
            <Setter Property="Foreground" Value="#353846" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5E6AD2" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5E6AD2" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="7,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,4" /><Setter Property="BorderBrush" Value="#CBD0DD" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DDE0E8" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#F0F1F5" />
            <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="34" /><Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F6FA" /><Setter Property="Foreground" Value="#596174" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#E7E9F0" /><Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E9ECFF" /><Setter Property="Foreground" Value="#303976" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#DDE2FF" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="14,7" /></Style>
        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ActiveFilterControl" TargetType="{x:Type Control}">
            <Setter Property="Background" Value="#EEF0FF" /><Setter Property="Foreground" Value="#303976" />
            <Setter Property="BorderBrush" Value="#5E6AD2" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActiveQuickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#5E6AD2" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5E6AD2" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="16" SizeChanged="Layout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" /><RowDefinition Height="8" />
            <RowDefinition Height="0.9*" MinHeight="145" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <WrapPanel x:Name="SourceControls" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="OpenEvtxButton" Content="{local:Loc OpenEvtx}" ToolTip="Ctrl+O" Click="OpenEvtx_Click" Margin="0,0,6,0" />
                <Button x:Name="LocalSourceButton" Content="{local:Loc ReturnLocal}" Click="LocalSource_Click" Visibility="Collapsed" Margin="0,0,6,0" />
                <ComboBox x:Name="LanguageBox" Width="94" AutomationProperties.Name="{local:Loc Language}" SelectionChanged="Language_Changed">
                    <ComboBoxItem Tag="en" Content="English" /><ComboBoxItem Tag="zh-TW" Content="繁體中文" />
                </ComboBox>
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="EventFast" FontSize="23" FontWeight="SemiBold" />
                <TextBlock x:Name="SourceText" Text="{local:Loc LocalLogs}" Foreground="#666D80" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE0E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="FilterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="210">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{local:Loc Cancel}" IsEnabled="False" Click="Cancel_Click" Margin="6,0,0,0" ToolTip="Esc" />
                        <Grid x:Name="QueryControls">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox" MinHeight="36" Padding="8,4" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc Search}"
                                         ToolTip="{local:Loc SearchTip}" TextChanged="ManualFilter_Changed" />
                                <TextBlock Text="{local:Loc SearchTip}" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="#6A7080" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="SearchButton" Grid.Column="1" Content="{local:Loc Search}" IsDefault="True" Click="Search_Click" Background="#5E6AD2" Foreground="White" Margin="8,0,0,0" />
                            <Button x:Name="RefreshButton" Grid.Column="2" Content="{local:Loc Refresh}" ToolTip="F5" Click="Refresh_Click" Margin="6,0,0,0" />
                            <Button x:Name="ResetFiltersButton" Grid.Column="3" Content="{local:Loc ResetFilters}" Click="ResetFilters_Click" Margin="6,0,0,0" />
                        </Grid>
                    </DockPanel>
                    <WrapPanel x:Name="FilterControls" IsEnabled="{Binding IsEnabled, ElementName=QueryControls}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="{local:Loc Time}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="TimeBox" Width="135" SelectedIndex="5" AutomationProperties.Name="{local:Loc Time}" SelectionChanged="Time_Changed">
                                <ComboBoxItem Tag="1" Content="{local:Loc Last1Hour}" /><ComboBoxItem Tag="3" Content="{local:Loc Last3Hours}" />
                                <ComboBoxItem Tag="6" Content="{local:Loc Last6Hours}" /><ComboBoxItem Tag="12" Content="{local:Loc Last12Hours}" />
                                <ComboBoxItem Tag="today" Content="{local:Loc Today}" /><ComboBoxItem Tag="24" Content="{local:Loc Last24Hours}" />
                                <ComboBoxItem Tag="72" Content="{local:Loc Last3Days}" /><ComboBoxItem Tag="168" Content="{local:Loc Last7Days}" />
                                <ComboBoxItem Tag="720" Content="{local:Loc Last30Days}" /><ComboBoxItem Tag="custom" Content="{local:Loc Custom}" /><ComboBoxItem Tag="all" Content="{local:Loc AllTime}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="CustomTimePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,16,8">
                            <DatePicker x:Name="FromDate" Width="130" AutomationProperties.Name="{local:Loc FromDate}" SelectedDateChanged="Filter_Changed" />
                            <TextBlock Text="{local:Loc To}" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker x:Name="ToDate" Width="130" AutomationProperties.Name="{local:Loc ToDate}" SelectedDateChanged="Filter_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="{local:Loc Level}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="LevelBox" Width="172" SelectedIndex="2" AutomationProperties.Name="{local:Loc Level}" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Tag="1" Content="{local:Loc CriticalOnly}" /><ComboBoxItem Tag="2" Content="{local:Loc ErrorsAndAbove}" />
                                <ComboBoxItem Tag="3" Content="{local:Loc WarningsAndAbove}" /><ComboBoxItem Tag="0" Content="{local:Loc All}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" MinHeight="30">
                            <CheckBox x:Name="SystemBox" Content="System" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ManualFilter_Changed" Unchecked="ManualFilter_Changed" />
                            <CheckBox x:Name="ApplicationBox" Content="Application" IsChecked="True" VerticalAlignment="Center" Checked="ManualFilter_Changed" Unchecked="ManualFilter_Changed" />
                        </StackPanel>
                    </WrapPanel>
            <WrapPanel x:Name="QuickFilterPanel">
                <Button Tag="all" Content="{local:Loc QuickAll}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="system" Content="{local:Loc QuickSystem}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="crash" Content="{local:Loc QuickCrash}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="disk" Content="{local:Loc QuickDisk}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="ntfs" Content="{local:Loc QuickNtfs}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="usb" Content="{local:Loc QuickUsb}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="device" Content="{local:Loc QuickDevice}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="driver" Content="{local:Loc QuickDriver}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="whea" Content="{local:Loc QuickWhea}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="network" Content="{local:Loc QuickNetwork}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="update" Content="{local:Loc QuickUpdate}" Click="Quick_Click" Margin="0,0,6,6" />
                <Button Tag="power" Content="{local:Loc QuickPower}" Click="Quick_Click" Margin="0,0,6,6" />
            </WrapPanel>

                    <TextBlock x:Name="ActiveFiltersText" Foreground="#4C5587" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="{local:Loc Results}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="{local:Loc Sort}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="SortBox" Width="125" SelectedIndex="0" AutomationProperties.Name="{local:Loc Sort}" SelectionChanged="Sort_Changed" Margin="0,0,16,0">
                    <ComboBoxItem Tag="default" Content="{local:Loc Default}" /><ComboBoxItem Tag="latest" Content="{local:Loc Latest}" />
                    <ComboBoxItem Tag="oldest" Content="{local:Loc Oldest}" /><ComboBoxItem Tag="frequent" Content="{local:Loc MostFrequent}" />
                    <ComboBoxItem Tag="eventId" Content="{local:Loc EventId}" /><ComboBoxItem Tag="provider" Content="Provider" />
                </ComboBox>
                <ComboBox x:Name="ExportScopeBox" Width="170" SelectedIndex="0" AutomationProperties.Name="{local:Loc ExportScope}" Margin="0,0,8,0">
                    <ComboBoxItem Tag="current" Content="{local:Loc ExportCurrent}" /><ComboBoxItem Tag="selected" Content="{local:Loc ExportSelected}" /><ComboBoxItem Tag="all" Content="{local:Loc ExportAll}" />
                </ComboBox>
                <CheckBox x:Name="IncludeXmlBox" Content="{local:Loc IncludeXml}" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Content="{local:Loc ExportExcel}" IsEnabled="False" Click="Export_Click" ToolTip="Ctrl+E" />
            </WrapPanel>
        <DataGrid x:Name="EventsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="EventsGrid_SelectionChanged" MouseDoubleClick="EventsGrid_MouseDoubleClick"
                  PreviewMouseRightButtonDown="EventsGrid_PreviewMouseRightButtonDown"
                  ContextMenuOpening="EventsGrid_ContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{local:Loc SearchPossibleCauses}" Click="SearchProblemOnline_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Loc ColumnSeverity}" Binding="{Binding Severity}" Width="95" />
                <DataGridTextColumn Header="{local:Loc ColumnProblem}" Binding="{Binding Problem}" Width="2*" MinWidth="170" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="{local:Loc ColumnCount}" Binding="{Binding Count}" Width="70" />
                <DataGridTextColumn Header="{local:Loc EventId}" Binding="{Binding EventId}" Width="85" />
                <DataGridTextColumn Header="{local:Loc ColumnSource}" Binding="{Binding Provider}" Width="2*" MinWidth="170" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="{local:Loc ColumnLastSeen}" Binding="{Binding LastSeen, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>


            <Border x:Name="EmptyStatePanel" Grid.Row="1" Margin="1,35,1,1" Background="White" IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=EventsGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock x:Name="EmptyStateText" Text="{local:Loc ReadyHint}" Foreground="#666D80" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="20,8" />
            </Border>
        </Grid>
        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="True" AutomationProperties.Name="{local:Loc ResizeDetails}" />
        <GroupBox Grid.Row="4" Header="{local:Loc ProblemDetails}" Margin="0" Padding="8" Background="White" BorderBrush="#DDE0E8">
            <TabControl x:Name="DetailsTabs">
                <TabItem x:Name="OccurrencesTab" Header="{local:Loc GroupedEvents}">
                    <DataGrid x:Name="OccurrencesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="OccurrencesGrid_SelectionChanged" MouseDoubleClick="OccurrencesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:Loc ColumnTime}" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTextColumn Header="{local:Loc ColumnSeverity}" Binding="{Binding DisplayLevel}" Width="90" />
                            <DataGridTextColumn Header="{local:Loc EventId}" Binding="{Binding EventId}" Width="85" />
                            <DataGridTextColumn Header="{local:Loc ColumnSource}" Binding="{Binding Provider}" Width="2*" MinWidth="150" />
                            <DataGridTextColumn Header="{local:Loc Channel}" Binding="{Binding Channel}" Width="2*" MinWidth="150" />
                            <DataGridTextColumn Header="{local:Loc RecordId}" Binding="{Binding RecordId}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="EventContentTab" Header="{local:Loc EventContent}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{local:Loc CopyProblem}" Click="CopyProblem_Click" Margin="0,0,6,0" Padding="10,4" />
                            <Button x:Name="CopyFullButton" Content="{local:Loc CopyFull}" Click="CopyFull_Click" IsEnabled="False" Margin="0,0,6,0" Padding="10,4" />
                            <Button Content="{local:Loc SearchPossibleCauses}" Click="SearchSelectedEventOnline_Click" Padding="10,4" />
                        </StackPanel>
                        <TextBox x:Name="DetailsBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 Padding="12" FontFamily="Microsoft JhengHei UI" FontSize="14" TextBlock.LineHeight="22"
                                 Background="White" BorderBrush="#C7D2DE"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="ParsedXmlTab" Header="{local:Loc ParsedXml}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button x:Name="CopyXmlButton" Content="{local:Loc CopyXml}" Click="CopyXml_Click" IsEnabled="False"
                                Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <TextBlock x:Name="ParsedXmlStatus" Grid.Row="1" TextWrapping="Wrap" Foreground="#A1260D" Margin="0,0,0,6" />
                        <TreeView x:Name="ParsedXmlTree" Grid.Row="2"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Header}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#5E6AD2" Margin="0,0,0,6" AutomationProperties.Name="{local:Loc Querying}" />
            <DockPanel>
                <Button x:Name="AdminButton" DockPanel.Dock="Right" Content="{local:Loc RestartAdmin}" Visibility="Collapsed" Margin="8,0,0,0" Click="Admin_Click" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="42">
                    <TextBlock x:Name="StatusText" Text="{local:Loc Shortcuts}" VerticalAlignment="Center" Foreground="#596174" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
