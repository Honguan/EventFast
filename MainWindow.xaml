<Window x:Class="EventFast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventFast"
        Title="EventFast" Icon="Assets/EventFast.ico" Height="760" Width="1180" MinHeight="560" MinWidth="820"
        Background="#F4F6F8" PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Width="96" Margin="8,0,0,0"
                    Content="{local:Loc Search}" IsDefault="True" Click="Search_Click" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Width="72" Margin="8,0,0,0"
                    Content="{local:Loc Cancel}" IsEnabled="False" Click="Cancel_Click" />
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Width="110" IsEnabled="False"
                    Content="{local:Loc ExportExcel}" Click="Export_Click" />
            <ComboBox x:Name="ExportScopeBox" DockPanel.Dock="Right" Width="110" SelectedIndex="0" Margin="8,0">
                <ComboBoxItem Tag="current" Content="{local:Loc ExportCurrent}" />
                <ComboBoxItem Tag="selected" Content="{local:Loc ExportSelected}" />
                <ComboBoxItem Tag="all" Content="{local:Loc ExportAll}" />
            </ComboBox>
            <CheckBox x:Name="IncludeXmlBox" DockPanel.Dock="Right" Content="{local:Loc IncludeXml}" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center"
                     ToolTip="{local:Loc SearchTip}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
            <TextBlock Text="{local:Loc Time}" VerticalAlignment="Center" />
            <ComboBox x:Name="TimeBox" Width="125" SelectedIndex="5" SelectionChanged="Time_Changed">
                <ComboBoxItem Tag="1" Content="{local:Loc Last1Hour}" />
                <ComboBoxItem Tag="3" Content="{local:Loc Last3Hours}" />
                <ComboBoxItem Tag="6" Content="{local:Loc Last6Hours}" />
                <ComboBoxItem Tag="12" Content="{local:Loc Last12Hours}" />
                <ComboBoxItem Tag="today" Content="{local:Loc Today}" />
                <ComboBoxItem Tag="24" Content="{local:Loc Last24Hours}" />
                <ComboBoxItem Tag="72" Content="{local:Loc Last3Days}" />
                <ComboBoxItem Tag="168" Content="{local:Loc Last7Days}" />
                <ComboBoxItem Tag="720" Content="{local:Loc Last30Days}" />
                <ComboBoxItem Tag="custom" Content="{local:Loc Custom}" />
                <ComboBoxItem Tag="all" Content="{local:Loc AllTime}" />
            </ComboBox>
            <StackPanel x:Name="CustomTimePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                <DatePicker x:Name="FromDate" Width="120" />
                <TextBlock Text="{local:Loc To}" VerticalAlignment="Center" Margin="4,0" />
                <DatePicker x:Name="ToDate" Width="120" />
            </StackPanel>
            <TextBlock Text="{local:Loc Level}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <ComboBox x:Name="LevelBox" Width="120" SelectedIndex="2">
                <ComboBoxItem Tag="1" Content="{local:Loc CriticalOnly}" />
                <ComboBoxItem Tag="2" Content="{local:Loc ErrorsAndAbove}" />
                <ComboBoxItem Tag="3" Content="{local:Loc WarningsAndAbove}" />
                <ComboBoxItem Tag="0" Content="{local:Loc All}" />
            </ComboBox>
            <CheckBox x:Name="SystemBox" Content="System" IsChecked="True" Margin="24,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="ApplicationBox" Content="Application" IsChecked="True" VerticalAlignment="Center" />
            <Button x:Name="AdminButton" Content="{local:Loc RestartAdmin}" Visibility="Collapsed" Margin="16,0,0,0" Click="Admin_Click" />
            <TextBlock Text="{local:Loc Sort}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <ComboBox x:Name="SortBox" Width="100" SelectedIndex="0" SelectionChanged="Sort_Changed">
                <ComboBoxItem Tag="default" Content="{local:Loc Default}" />
                <ComboBoxItem Tag="latest" Content="{local:Loc Latest}" />
                <ComboBoxItem Tag="oldest" Content="{local:Loc Oldest}" />
                <ComboBoxItem Tag="frequent" Content="{local:Loc MostFrequent}" />
                <ComboBoxItem Tag="eventId" Content="{local:Loc EventId}" />
                <ComboBoxItem Tag="provider">Provider</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="{local:Loc Language}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <ComboBox x:Name="LanguageBox" Width="88" SelectionChanged="Language_Changed">
                <ComboBoxItem Tag="en" Content="English" />
                <ComboBoxItem Tag="zh-TW" Content="中文" />
            </ComboBox>
            <TextBlock x:Name="StatusText" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="#40566C" />
        </StackPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Tag="all" Content="{local:Loc QuickAll}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="system" Content="{local:Loc QuickSystem}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="crash" Content="{local:Loc QuickCrash}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="disk" Content="{local:Loc QuickDisk}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="ntfs" Content="{local:Loc QuickNtfs}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="usb" Content="{local:Loc QuickUsb}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="device" Content="{local:Loc QuickDevice}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="driver" Content="{local:Loc QuickDriver}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="whea" Content="{local:Loc QuickWhea}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="network" Content="{local:Loc QuickNetwork}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="update" Content="{local:Loc QuickUpdate}" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="power" Content="{local:Loc QuickPower}" Click="Quick_Click" Margin="0,0,6,6" />
        </WrapPanel>

        <DataGrid x:Name="EventsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="EventsGrid_SelectionChanged" MouseDoubleClick="EventsGrid_MouseDoubleClick"
                  PreviewMouseRightButtonDown="EventsGrid_PreviewMouseRightButtonDown"
                  ContextMenuOpening="EventsGrid_ContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{local:Loc SearchPossibleCauses}" Click="SearchProblemOnline_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Loc ColumnSeverity}" Binding="{Binding Severity}" Width="70" />
                <DataGridTextColumn Header="{local:Loc ColumnProblem}" Binding="{Binding Problem}" Width="2*" />
                <DataGridTextColumn Header="{local:Loc ColumnCount}" Binding="{Binding Count}" Width="70" />
                <DataGridTextColumn Header="{local:Loc EventId}" Binding="{Binding EventId}" Width="85" />
                <DataGridTextColumn Header="{local:Loc ColumnSource}" Binding="{Binding Provider}" Width="2*" />
                <DataGridTextColumn Header="{local:Loc ColumnLastSeen}" Binding="{Binding LastSeen}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="4" Header="{local:Loc ProblemDetails}" Margin="0,12,0,0">
            <TabControl x:Name="DetailsTabs">
                <TabItem x:Name="OccurrencesTab" Header="{local:Loc GroupedEvents}">
                    <DataGrid x:Name="OccurrencesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="OccurrencesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:Loc ColumnTime}" Binding="{Binding Time}" Width="160" />
                            <DataGridTextColumn Header="{local:Loc ColumnSeverity}" Binding="{Binding DisplayLevel}" Width="90" />
                            <DataGridTextColumn Header="{local:Loc EventId}" Binding="{Binding EventId}" Width="85" />
                            <DataGridTextColumn Header="{local:Loc ColumnSource}" Binding="{Binding Provider}" Width="2*" />
                            <DataGridTextColumn Header="{local:Loc Channel}" Binding="{Binding Channel}" Width="2*" />
                            <DataGridTextColumn Header="{local:Loc RecordId}" Binding="{Binding RecordId}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="EventContentTab" Header="{local:Loc EventContent}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{local:Loc CopyProblem}" Click="CopyProblem_Click" Margin="0,0,6,0" Padding="10,4" />
                            <Button Content="{local:Loc CopyFull}" Click="CopyFull_Click" Margin="0,0,6,0" Padding="10,4" />
                            <Button Content="{local:Loc SearchPossibleCauses}" Click="SearchSelectedEventOnline_Click" Padding="10,4" />
                        </StackPanel>
                        <TextBox x:Name="DetailsBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 Padding="12" FontFamily="Microsoft JhengHei UI" FontSize="14" TextBlock.LineHeight="22"
                                 Background="White" BorderBrush="#C7D2DE"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="ParsedXmlTab" Header="{local:Loc ParsedXml}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button x:Name="CopyXmlButton" Content="{local:Loc CopyXml}" Click="CopyXml_Click" IsEnabled="False"
                                Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <TextBlock x:Name="ParsedXmlStatus" Grid.Row="1" TextWrapping="Wrap" Foreground="#A1260D" Margin="0,0,0,6" />
                        <TreeView x:Name="ParsedXmlTree" Grid.Row="2"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Header}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</Window>
