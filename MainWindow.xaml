<Window x:Class="EventFast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventFast" Height="760" Width="1180" MinHeight="560" MinWidth="820"
        Background="#F4F6F8" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Width="96" Margin="8,0,0,0"
                    Content="搜尋" IsDefault="True" Click="Search_Click" />
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Width="110" IsEnabled="False"
                    Content="匯出 Excel" Click="Export_Click" />
            <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center"
                     ToolTip="搜尋關鍵字、Event ID，或混合條件（例如 disk 153）" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
            <TextBlock Text="時間：" VerticalAlignment="Center" />
            <ComboBox x:Name="TimeBox" Width="125" SelectedIndex="4">
                <ComboBoxItem Tag="1">最近 1 小時</ComboBoxItem>
                <ComboBoxItem Tag="3">最近 3 小時</ComboBoxItem>
                <ComboBoxItem Tag="12">最近 12 小時</ComboBoxItem>
                <ComboBoxItem Tag="today">今天</ComboBoxItem>
                <ComboBoxItem Tag="24">最近 24 小時</ComboBoxItem>
                <ComboBoxItem Tag="72">最近 3 天</ComboBoxItem>
                <ComboBoxItem Tag="168">最近 7 天</ComboBoxItem>
                <ComboBoxItem Tag="720">最近 30 天</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="等級：" VerticalAlignment="Center" Margin="20,0,0,0" />
            <ComboBox x:Name="LevelBox" Width="120" SelectedIndex="2">
                <ComboBoxItem Tag="1">只看嚴重</ComboBoxItem>
                <ComboBoxItem Tag="2">錯誤以上</ComboBoxItem>
                <ComboBoxItem Tag="3">警告以上</ComboBoxItem>
                <ComboBoxItem Tag="0">全部</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="SystemBox" Content="System" IsChecked="True" Margin="24,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="ApplicationBox" Content="Application" IsChecked="True" VerticalAlignment="Center" />
            <TextBlock Text="排序：" VerticalAlignment="Center" Margin="20,0,0,0" />
            <ComboBox x:Name="SortBox" Width="100" SelectedIndex="0" SelectionChanged="Sort_Changed">
                <ComboBoxItem Tag="default">預設</ComboBoxItem>
                <ComboBoxItem Tag="latest">最新</ComboBoxItem>
                <ComboBoxItem Tag="frequent">最頻繁</ComboBoxItem>
                <ComboBoxItem Tag="eventId">Event ID</ComboBoxItem>
                <ComboBoxItem Tag="provider">Provider</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="StatusText" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="#40566C" />
        </StackPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Tag="all" Content="全部問題" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="system" Content="系統錯誤" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="crash" Content="程式崩潰" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="disk" Content="磁碟 / SSD / NVMe" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="ntfs" Content="NTFS / 檔案系統" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="usb" Content="USB / USB-C" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="device" Content="裝置" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="driver" Content="驅動程式" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="whea" Content="硬體 / WHEA" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="network" Content="網路" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="update" Content="Windows Update" Click="Quick_Click" Margin="0,0,6,6" />
            <Button Tag="power" Content="電源 / 異常關機" Click="Quick_Click" Margin="0,0,6,6" />
        </WrapPanel>

        <DataGrid x:Name="EventsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="EventsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="等級" Binding="{Binding Severity}" Width="70" />
                <DataGridTextColumn Header="問題" Binding="{Binding Problem}" Width="2*" />
                <DataGridTextColumn Header="次數" Binding="{Binding Count}" Width="70" />
                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="85" />
                <DataGridTextColumn Header="來源" Binding="{Binding Provider}" Width="2*" />
                <DataGridTextColumn Header="最後發生" Binding="{Binding LastSeen}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="4" Header="事件詳細資料" Margin="0,12,0,0">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
